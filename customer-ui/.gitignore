# Dependencies installed by npm (restored via `npm install`; never committed).
node_modules/

# Vite production build output (regenerated by `npm run build`).
dist/

# Vite/local runtime caches and environment overrides.
.vite/
*.local

# Log files emitted by npm/tooling.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
