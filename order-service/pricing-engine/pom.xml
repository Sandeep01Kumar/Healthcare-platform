<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ Pricing Engine — Maven build descriptor
  ~
  ~ This is the FOUNDATIONAL module in the multi-module build order:
  ~     pricing-engine  ->  order-service  ->  healthcare-platform
  ~
  ~ It must be installable into the local Maven repository (`mvn install`)
  ~ BEFORE `order-service` builds, because `order-service/pom.xml` declares a
  ~ dependency on this module's published artifact. The three published
  ~ coordinates below (groupId / artifactId / version) are a hard contract with
  ~ that downstream module and MUST NOT be changed in isolation.
  ~
  ~ Responsibility of this module: coupon-aware, multi-coupon discount
  ~ calculation for the order-commerce "Coupon and Order Tracking" feature.
  ~ It has NO server, persistence, or inter-module dependencies — it is a plain,
  ~ self-contained library jar with unit tests.
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      ~ Published coordinates (HARD CONTRACT with order-service/pom.xml).
      ~ order-service depends on EXACTLY:
      ~     com.healthcare : pricing-engine : 1.0.0
      ~ Any change here breaks the downstream order-service build.
      -->
    <groupId>com.healthcare</groupId>
    <artifactId>pricing-engine</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Pricing Engine</name>
    <description>
        Coupon-aware discount calculation library for the order-commerce platform.
        Computes single- and multi-coupon (stacked) discounts and supersedes the
        legacy fixed 10% reduction. Foundational module consumed by order-service.
    </description>

    <properties>
        <!--
          ~ Compile against the Java 21 LTS release. Using `maven.compiler.release`
          ~ (rather than separate source/target) guarantees the compiler also
          ~ validates that only Java 21 platform APIs are referenced.
          -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Force UTF-8 for source (and resource/report) encoding for reproducibility. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          ~ Centralized, pinned versions. JUnit is pinned to 5.11.4 (the exact
          ~ 5.11.x patch available/verified in the offline local repository).
          ~ Plugin versions are pinned so the build is deterministic and does not
          ~ depend on Maven's built-in default plugin versions.
          -->
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
        <maven.compiler.plugin.version>3.14.1</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.6</maven.surefire.plugin.version>
    </properties>

    <!--
      ~ Dependencies — MINIMAL by design. This is the root of the module
      ~ dependency order, so it must NOT depend on order-service,
      ~ notification-service, customer-ui, or any other repository module, and
      ~ it pulls in NO Spring / HTTP / persistence / JDBC libraries.
      ~
      ~ JUnit 5 (Jupiter) is the ONLY dependency and is confined to `test` scope,
      ~ so it never leaks onto the runtime/compile classpath of consumers. The
      ~ `junit-jupiter` aggregator transitively provides the API, params, and
      ~ engine artifacts needed to author and execute the mandated discount tests.
      -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          ~ NON-STANDARD SOURCE LAYOUT.
          ~
          ~ The project convention keeps the production Java classes
          ~ (DiscountCalculator.java, Coupon.java, CouponDiscountCalculator.java)
          ~ package-less at the MODULE ROOT rather than under src/main/java.
          ~ We therefore point the main source directory at the module root.
          ~
          ~ The maven-compiler-plugin `<includes>` below restrict the main compile
          ~ to a single directory level (`*.java`), so ONLY the root-level classes
          ~ are treated as main sources; nested trees such as `src/test/**` and
          ~ `target/**` are never swept into the main compilation.
          ~
          ~ `testSourceDirectory` is intentionally left at its Maven default
          ~ (${project.basedir}/src/test/java) so the JUnit 5 tests are picked up
          ~ as TEST sources by the normal test-compile / surefire lifecycle.
          -->
        <sourceDirectory>${project.basedir}</sourceDirectory>

        <plugins>
            <!--
              ~ Compiler: Java 21 release, restricted to top-level *.java main sources.
              ~ The single-level `*.java` glob (no `**/`) matches only files directly
              ~ in the source root, which is exactly the three package-less classes;
              ~ it does not recurse into src/test/** or target/**.
              -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <includes>
                        <include>*.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!--
              ~ Surefire: runs the JUnit 5 (JUnit Platform) tests under
              ~ src/test/java during `mvn test`. Default configuration is fully
              ~ non-interactive and requires no JUnit 4 provider; the JUnit
              ~ Platform provider is auto-selected from the junit-jupiter engine
              ~ on the test classpath.
              -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
            </plugin>
        </plugins>
    </build>

</project>
