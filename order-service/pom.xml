<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  order-service — Maven build (Coupon & Order Tracking feature)
  ============================================================================
  Build/test tooling for the order-service Java module. It hosts the mandated
  JUnit 5 tests (OrderServiceTest, CouponValidatorTest) and produces a plain
  JAR of the order domain classes.

  CROSS-MODULE COORDINATION (must stay consistent with the pricing-engine pom):
    groupId = com.healthcare, version = 1.0.0
      - this module            -> artifactId = order-service
      - the pricing-engine one -> artifactId = pricing-engine
    Build order is pricing-engine -> order-service: the pricing-engine artifact
    (com.healthcare:pricing-engine:1.0.0) MUST be `mvn install`-ed into the
    local repository BEFORE this module is built, because OrderService references
    the pricing-engine discount types on the compile classpath.

  SOURCE LAYOUT (standard Maven):
    Main Java sources live under src/main/java in the named package
    `com.healthcare.order` (OrderService, OrderStatus, Coupon, and the later
    Order, CouponValidator). Named packages are REQUIRED: the validation-side
    `com.healthcare.order.Coupon` compiled here must coexist on the classpath
    with the DISTINCT discount-side `com.healthcare.pricing.Coupon` pulled in
    from the pricing-engine dependency. Package-less (default-package) classes
    would collide by binary name across the two jars, so both modules are
    namespaced. Tests live under src/test/java (Maven default) in the same
    package and are picked up as TEST sources.

  OFFLINE VERSION PINS:
    Plugin/dependency versions are pinned to the artifacts already present in the
    local Maven repository so the build succeeds fully offline.
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Module coordinates: EXACTLY com.healthcare:order-service:1.0.0 -->
    <groupId>com.healthcare</groupId>
    <artifactId>order-service</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Order Service</name>
    <description>
        Order lifecycle service: coupon validation API, order status handling
        (CREATED -> CONFIRMED -> DELIVERED), and orchestration of the
        pricing-engine coupon discount and status-change notifications.
    </description>

    <properties>
        <!-- Java 21 (LTS) compile target/runtime via the compiler plugin. -->
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Deterministic, platform-independent source encoding. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Centralized, offline-present version pins (see header note). -->
        <pricing-engine.version>1.0.0</pricing-engine.version>
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    </properties>

    <dependencies>
        <!--
            Inter-module dependency on the pricing-engine artifact. OrderService
            references the discount types via their qualified package
            `com.healthcare.pricing`. Honors the AAP build order: pricing-engine
            must be installed to the local repo first. Because both modules are
            namespaced, the discount-side `com.healthcare.pricing.Coupon` and the
            validation-side `com.healthcare.order.Coupon` coexist on this module's
            classpath with no binary-name collision.
        -->
        <dependency>
            <groupId>com.healthcare</groupId>
            <artifactId>pricing-engine</artifactId>
            <version>${pricing-engine.version}</version>
        </dependency>

        <!--
            JUnit 5 (Jupiter) aggregator — test scope only. Pulls in the Jupiter
            API, engine, and params modules for authoring and running the
            order-service status-transition and coupon-validation tests.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                maven-compiler-plugin: standard Maven layout, so the default
                source roots (src/main/java, src/test/java) are compiled. Java
                release level is taken from the maven.compiler.release property
                above. No source-directory override or include filter is needed;
                the nested pricing-engine/ directory is a SEPARATE module and is
                not under this module's src/main/java, so it is never swept into
                this compilation.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>

            <!--
                maven-surefire-plugin: runs the JUnit 5 tests under src/test/java
                non-interactively during the `test` phase (JUnit Platform provider).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

</project>
